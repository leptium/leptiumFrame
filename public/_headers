/*
  # Prevención estricta de Framing / Clickjacking
  X-Frame-Options: DENY
  # Prevención de sniffing de tipos MIME
  X-Content-Type-Options: nosniff
  # Política de Referrer para privacidad
  Referrer-Policy: strict-origin-when-cross-origin
  # Restricción de permisos y APIs del hardware host
  Permissions-Policy: camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  # HSTS (HTTP Strict Transport Security)
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  # Content Security Policy (CSP) hermético para PWA local-first
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https://images.unsplash.com; connect-src 'self' https://api.open-meteo.com https://geocoding-api.open-meteo.com; font-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self';

/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/app/*
  Cache-Control: public, max-age=0, must-revalidate
